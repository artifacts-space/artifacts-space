# Neon Postgres. Vercel's Neon integration sets these.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# The direct (unpooled) connection for migrations. In this file it beats DATABASE_URL
# for pnpm db:migrate, pnpm db:studio, and every drizzle-kit command that connects,
# but a URL set for the run beats both.
# Leave it out only when DATABASE_URL is a local database or an unpooled URL. With
# Neon's pooled URL, migrations need it, and a Vercel production build fails without it.
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Better Auth. At least 32 characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
# This site's origin. Production: https://artifacts.space
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth app. Callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth client (type: Web application).
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
# Google sign-in stays off while either value is empty or still a
# replace-with-... placeholder, and always on Vercel preview deploys, whose
# URLs are not registered redirect URIs. The sign-in pages read these when
# the app builds, so a change needs a new build, not just a restart.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sendir (sendir.ai) sends magic sign-in links from the identity's own address.
# Use a key scoped to that identity. Without them in development, the link
# prints to the dev server log instead. SENDIR_URL overrides https://sendir.ai.
SENDIR_API_KEY=
SENDIR_IDENTITY_ID=

# The site operator's address. Every reader report on an artifact is emailed
# here, and only here: team owners get no email. Without it, reports are still
# stored and each one logs a warning.
ABUSE_REPORT_EMAIL=abuse@example.com

# Cloudflare R2 holds uploaded files. Use an API token scoped to this bucket:
# the S3 access key is the token id, the secret is the SHA-256 of the token.
# The bucket needs CORS for PUT, GET, and HEAD from this site's origin.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional: another S3-compatible endpoint, such as a local MinIO for e2e
# tests (http://localhost:9000). Leave it unset in production.
R2_ENDPOINT=

# Vercel Cron sends this as a bearer token to /api/cron/*. At least 16 characters.
CRON_SECRET=

# Slack Incoming Webhook for "Something's not working" reports from the app.
# Must start with https://hooks.slack.com/; without a valid one the app says
# feedback is not available. A secret: never log or print it.
SLACK_FEEDBACK_WEBHOOK_URL=

# Optional per-account storage quotas in bytes. Defaults: 100 MB content, 1 GB files.
# STORAGE_QUOTA_CONTENT_BYTES=
# STORAGE_QUOTA_FILE_BYTES=
