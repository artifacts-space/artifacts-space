# Fast checks on staged files only. pre-push and CI run the full suite.
if [ ! -x node_modules/.bin/lint-staged ]; then
  echo "husky: dependencies are not installed, so pre-commit is skipped. Run pnpm install."
  exit 0
fi
# --no-stash: the task only reads files, so no backup is needed, and worktrees
# share one git stash stack that other sessions may be using.
lint-staged --no-stash --quiet
