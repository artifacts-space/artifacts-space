{
  "name": "artifacts-space",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "homepage": "https://artifacts.space",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artifacts-space/artifacts-space.git"
  },
  "bugs": "https://github.com/artifacts-space/artifacts-space/issues",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "check:lines": "node scripts/check-file-lines.mts",
    "check": "pnpm typecheck && pnpm lint && pnpm check:lines && pnpm test",
    "prepare": "husky",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/cimd": "1.7.18",
    "@better-auth/oauth-provider": "1.7.18",
    "@json-render/core": "0.21.1",
    "@json-render/react": "0.21.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@neondatabase/serverless": "^1.2.0",
    "@tabler/icons-react": "^3.50.0",
    "aws4fetch": "1.0.20",
    "better-auth": "1.7.18",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "mermaid": "12.2.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "husky": "^9.1.7",
    "lint-staged": "17.6.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.72.1",
    "vitest": "4.1.12"
  },
  "packageManager": "pnpm@10.11.1",
  "lint-staged": {
    "*.{ts,tsx,mts,mjs}": "eslint --max-warnings 0 --no-warn-ignored"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "subject-case": [
        0
      ],
      "body-max-line-length": [
        0
      ],
      "footer-max-line-length": [
        0
      ]
    }
  }
}
